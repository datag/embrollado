# Defaults for Embrollado's optional build-time configuration. Copy this file to `.env.local` to
# override per machine — both variables are optional and bake into the bundle at build time.

# Base URL of the bilingual privacy policy. The footer links to the language sections via the
# anchors #en and #de, so both anchors must exist on the target page. If this is not set, the
# footer shows no privacy links.
APP_PRIVACY_POLICY_URL=https://example.com/privacy

# Optional access code. Only when this is set does the app ask for the code before rendering; the
# value is baked into the build (a small hurdle against accidental use — not a security mechanism).
# Leave empty or remove the variable to disable the prompt.
# APP_ACCESS_CODE=letmein
#
# Note for developers: the Playwright e2e suite builds the app locally. If a non-empty
# APP_ACCESS_CODE ends up in an env file that Vite loads (e.g. .env.local), the e2e build will be
# gated and the suite will fail. Keep it out of build environments used by the tests.
